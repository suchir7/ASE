#!/usr/bin/env python3
"""A small command-line calculator."""

import sys


USAGE = "Usage: calculator <add|subtract|multiply> <number> <number>"


def add(first: float, second: float) -> float:
	"""Return the sum of two numbers."""
	return first + second


def subtract(first: float, second: float) -> float:
	"""Return the difference between two numbers."""
	return first - second


def multiply(first: float, second: float) -> float:
	"""Return the product of two numbers."""
	return first * second


def format_result(value: float) -> str:
	"""Avoid a trailing .0 when the result is a whole number."""
	return str(int(value)) if value.is_integer() else str(value)


def main() -> int:
	if sys.argv[1:] == ["--help"]:
		print(USAGE)
		return 0

	if len(sys.argv) == 4 and sys.argv[1].lower() in ("add", "subtract", "multiply"):
		try:
			first = float(sys.argv[2])
			second = float(sys.argv[3])
		except ValueError:
			print(USAGE, file=sys.stderr)
			return 2

		operations = {"add": add, "subtract": subtract, "multiply": multiply}
		operation = operations[sys.argv[1].lower()]
		print(format_result(operation(first, second)))
		return 0

	if len(sys.argv) != 1:
		print(USAGE, file=sys.stderr)
		return 2

	print("Calculator: enter two numbers separated by spaces, or press Ctrl+C to exit.")
	try:
		first, second = input("> ").split()
		print(format_result(add(float(first), float(second))))
	except (ValueError, EOFError):
		print("Please enter exactly two numbers.", file=sys.stderr)
		return 2
	except KeyboardInterrupt:
		print()
		return 0

	return 0


if __name__ == "__main__":
	raise SystemExit(main())
